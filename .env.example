# Anthropic API key for the booking assistant and the dashboard's Ask AI.
# Never commit the real value.
ANTHROPIC_API_KEY=

# Optional: which Claude model the assistant uses. Defaults to claude-sonnet-5-5.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Password for the CRM at /crm. At least 8 characters.
CRM_PASSWORD=

# Vercel Blob read-write token. Added automatically when a Blob store is
# connected to the project on Vercel. Without it, local dev saves leads to .data/.
# BLOB_READ_WRITE_TOKEN=

# Preview mode. Set to 1 to keep the site out of search engines while it is
# being reviewed. Leave unset for the real launch.
# NEXT_PUBLIC_DEMO_MODE=1

# Secret Vercel sends to the weekly retention cron (/api/cron/retention). Any long random string.
CRON_SECRET=

# Status page at /admin: its own password (12+ chars) and a bearer token for /admin/status.json.
ADMIN_PASSWORD=
ADMIN_STATUS_TOKEN=

# New-lead and failure emails through Resend.
RESEND_API_KEY=
# LEAD_NOTIFY_EMAIL=
# ALERT_EMAIL=
# EMAIL_FROM=Sal Dana <leads@yourdomain.com>

# Second Blob store for daily backups (optional but recommended).
# BACKUP_BLOB_READ_WRITE_TOKEN=   (BACKUP_READ_WRITE_TOKEN also works)
