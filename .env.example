# Anthropic API key for the booking assistant. Never commit the real value.
ANTHROPIC_API_KEY=

# Optional: which Claude model the assistant uses. Defaults to claude-fable-5-2.
# ANTHROPIC_MODEL=claude-fable-5-2

# Password for the CRM at /crm. At least 8 characters.
CRM_PASSWORD=

# Vercel Blob read-write token. Added automatically when a Blob store is
# connected to the project on Vercel. Without it, local dev saves leads to .data/.
# BLOB_READ_WRITE_TOKEN=

# Preview mode. Set to 1 to show the sample reviews section (labelled as samples)
# and keep the site out of search engines. Leave unset for the real launch.
# NEXT_PUBLIC_DEMO_MODE=1
